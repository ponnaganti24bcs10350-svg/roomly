# Roomly Backend Configuration
# Port the Express & Socket.IO server listens on
PORT=5050

# PostgreSQL connection string (supports local postgres or cloud hosts like Render/Supabase/Neon)
DATABASE_URL="postgresql://roomly:roomly_password@localhost:5432/roomly"

# Secret key used for signing & verifying JWT authentication tokens
JWT_SECRET="your_secure_random_jwt_secret_key"

# Frontend origin allowed by CORS
CLIENT_URL="http://localhost:5174"

# Node environment mode: 'development' or 'production'
NODE_ENV="development"

# (Optional) Groq AI API key for dynamic global listing generation
GROQ_API_KEY="your_groq_api_key_here"
